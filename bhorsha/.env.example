# Application Port
PORT=3000

# Database image on Docker Hub (used by docker-compose.yml)
# Pinned version, so everyone gets the same tables and seed data.
# When a new image is pushed (e.g. 2.1.0), update this line, then run `docker compose down -v` once.
DB_IMAGE=siam001/bhorsha-db:2.0.0

# Database login, used by docker compose to create the database
POSTGRES_DB=bhorsha
POSTGRES_USER=bhorsha
POSTGRES_PASSWORD=bhorsha123

# PostgreSQL Database Configuration (must match the login above)
DB_HOST=localhost
DB_PORT=5433
DB_USER=bhorsha
DB_PASSWORD=bhorsha123
DB_NAME=bhorsha

# Redis (for caching & rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Mailpit SMTP (Emergency SOS email dispatch)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=emergency@bhorsha.com
