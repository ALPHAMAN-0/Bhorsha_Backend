# Bhorsha settings: template. This file IS committed to git.
# Make your own copy:   cp .env.example .env      (Windows: copy .env.example .env)
#
# Read by docker compose (the database) and by the NestJS app.
# These are shared local-dev values: keep them the same so everyone connects the same way.

# --- App ---
PORT=3000

# --- Database image on Docker Hub ---
# Pinned version, so everyone gets the same tables and seed data.
# When a new image is pushed (e.g. 2.1.0), update this line, then run `docker compose down -v` once.
DB_IMAGE=siam001/bhorsha-db:2.0.0

# --- Database login, used by docker compose to create the database ---
POSTGRES_DB=bhorsha
POSTGRES_USER=bhorsha
POSTGRES_PASSWORD=bhorsha123

# --- How the app reaches the database (must match the login above) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=bhorsha
DB_PASSWORD=bhorsha123
DB_NAME=bhorsha
DB_POOL_MAX=10
DB_LOGGING=false

# Same connection as one URL (for Prisma, DBeaver, TablePlus...).
# If you change any value above, change it here too.
DATABASE_URL=postgresql://bhorsha:bhorsha123@localhost:5433/bhorsha

NODE_ENV=development
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
BCRYPT_ROUNDS=12

# --- Dev only: lets a request without a token use the x-user-id header ---
# true = Swagger and tests can still send x-user-id instead of logging in.
# Ignored when NODE_ENV=production. Keep it false for the demo and submission.
ALLOW_X_USER_ID=false

# --- Rider join requests: seconds before a PENDING request expires ---
# The design value is 12. Raise it (e.g. 600) for Swagger demos, so the driver has time to accept by hand.
RIDER_REQUEST_TTL_SECONDS=12

# --- Redis (for caching & rate limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Mailpit SMTP (Emergency SOS email dispatch) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=emergency@bhorsha.com
